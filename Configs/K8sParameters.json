{
   "K8sParameters": {
      "prefix_yaml_file":"mubench",
      "namespace": "ms",
      "image": "msvcbench/microservice:latest",
      "cluster_domain": "cluster.local",
      "path": "/api/v1",
      "dns-resolver":"kube-dns.kube-system.svc.cluster.local",
      "scheduler-name": "default-scheduler",
      "sleep": 0,
      "nginx-gw": true,
      "nginx-svc-type": "NodePort",
      "nginx-image": "nginx",
      "no-apply": false,
      "logger_level": "INFO",
      "nginx-replicas": 4,
      "nginx-node-affinity": {
         "key": "node-role.cosched.io/nginx-worker",
         "values": ["true"]
      },
      "worker-node-affinity": {
         "key": "node-role.cosched.io/general-worker",
         "values": ["true"]
      },
      "ms-replica": 1
   },
   "InternalServiceFilePath": "CustomFunctions",
   "OutputPath": "SimulationWorkspace",
   "WorkModelPath": "Examples/workmodel-cpu-profiler-10services.json"
}
